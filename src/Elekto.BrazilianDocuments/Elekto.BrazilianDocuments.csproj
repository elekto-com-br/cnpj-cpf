<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0;net11.0;netstandard2.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <CLSCompliant>true</CLSCompliant>

    <!-- NuGet Package Configuration -->
    <PackageId>Elekto.BrazilianDocuments</PackageId>
    <Title>Brazilian Documents (CPF/CNPJ)</Title>
    <Version>1.4.2</Version>
    <Authors>Elekto Produtos Financeiros</Authors>
    <Company>Elekto</Company>
    <Description>High-performance, zero-allocation validation for Brazilian documents (CNPJ and CPF). Supports the new alphanumeric CNPJ format introduced by Brazilian Federal Revenue Service.</Description>
    <PackageReleaseNotes>v1.4.2: Cnpj.IsValid and Cnpj.TryParse now trim the whitespace around a CNPJ, as the constructor already did, so that a CNPJ padded past 18 characters, as in a fixed-width field, is valid through all three. Cpf now trims whitespace and NUL around a CPF in any format, and through a span as well, where it used to accept surrounding spaces only on an unformatted string of up to 14 characters, and takes a plus sign anywhere as punctuation, as it did the minus. Cpf no longer depends on the current culture: 1.4.1 also took a sign in the culture's own form, such as the U+2212 minus of Swedish, and now only + and - count; apart from that, no input that 1.4.1 accepted is rejected. Trimming allocates nothing, and validating an unformatted CPF takes about a third less time.</PackageReleaseNotes>
    <PackageTags>cnpj;cpf;brazil;brazilian;validation;documents;receita-federal</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/elekto-com-br/cnpj-cpf</PackageProjectUrl>
    <RepositoryUrl>https://github.com/elekto-com-br/cnpj-cpf</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>elekto_logo_sq.300x300.png</PackageIcon>
    <Copyright>Copyright (c) 2013-2026 Elekto Produtos Financeiros</Copyright>

    <!-- Enable Source Link for debugging -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\assets\elekto_logo_sq.300x300.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- Polyfill for netstandard2.0 -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Text.Json" Version="10.0.14" />
    <PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="6.1.2" />
  </ItemGroup>

</Project>
