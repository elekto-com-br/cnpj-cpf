<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0;netstandard2.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <CLSCompliant>true</CLSCompliant>

    <!-- NuGet Package Configuration -->
    <PackageId>Elekto.BrazilianDocuments</PackageId>
    <Title>Brazilian Documents (CPF/CNPJ)</Title>
    <Version>1.4.0</Version>
    <Authors>Elekto Produtos Financeiros</Authors>
    <Company>Elekto</Company>
    <Description>High-performance, zero-allocation validation for Brazilian documents (CNPJ and CPF). Supports the new alphanumeric CNPJ format introduced by Brazilian Federal Revenue Service.</Description>
    <PackageReleaseNotes>v1.4.0: Adds a net11.0 build and drops net8.0 and net9.0, since .NET 8 and 9 left support on 10 November 2026. Apps on .NET 8 and 9 keep working on the netstandard2.0 build, the one .NET Framework 4.6.2 and later use, but it brings them the System.Text.Json 10.0.14 package, which the whole app then uses instead of the System.Text.Json of its shared framework. An app that references System.Text.Json 8.x or 9.x directly must move it to 10.0.14 or later, or restore fails on a package downgrade (NU1605). The netstandard2.0 build now depends on System.Text.Json 10.0.14 instead of 10.0.13, with Microsoft.Bcl.AsyncInterfaces, System.IO.Pipelines and System.Text.Encodings.Web 10.0.14. No change to the library's code; net10.0 and net11.0 depend on no package.</PackageReleaseNotes>
    <PackageTags>cnpj;cpf;brazil;brazilian;validation;documents;receita-federal</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/elekto-com-br/cnpj-cpf</PackageProjectUrl>
    <RepositoryUrl>https://github.com/elekto-com-br/cnpj-cpf</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>elekto_logo_sq.300x300.png</PackageIcon>
    <Copyright>Copyright (c) 2013-2026 Elekto Produtos Financeiros</Copyright>

    <!-- Enable Source Link for debugging -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\assets\elekto_logo_sq.300x300.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- Polyfill for netstandard2.0 -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Text.Json" Version="10.0.14" />
    <PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="6.1.2" />
  </ItemGroup>

</Project>
