<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0;netstandard2.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <CLSCompliant>true</CLSCompliant>

    <!-- NuGet Package Configuration -->
    <PackageId>Elekto.BrazilianDocuments</PackageId>
    <Title>Brazilian Documents (CPF/CNPJ)</Title>
    <Version>1.3.0</Version>
    <Authors>Elekto Produtos Financeiros</Authors>
    <Company>Elekto</Company>
    <Description>High-performance, zero-allocation validation for Brazilian documents (CNPJ and CPF). Supports the new alphanumeric CNPJ format introduced by Brazilian Federal Revenue Service.</Description>
    <PackageReleaseNotes>v1.3.0: The netstandard2.0 build, which .NET Framework 4.6.2 and later and .NET before 8 use, now depends on System.Text.Json 10.0.13 instead of 8.0.5, since the 8.x line leaves support with .NET 8 on 10 November 2026. Microsoft.Bcl.AsyncInterfaces, System.Text.Encodings.Web and System.IO.Pipelines 10.0.13 come with it. A project that references System.Text.Json 8.x directly must move it to 10.0.13 or later, or restore fails on a package downgrade (NU1605). On .NET 6 and 7, both out of support, System.Text.Json 10 warns at build time that it does not support them. No change to the library's code, nor to net8.0, net9.0 and net10.0, which depend on no package.</PackageReleaseNotes>
    <PackageTags>cnpj;cpf;brazil;brazilian;validation;documents;receita-federal</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/elekto-com-br/cnpj-cpf</PackageProjectUrl>
    <RepositoryUrl>https://github.com/elekto-com-br/cnpj-cpf</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>elekto_logo_sq.300x300.png</PackageIcon>
    <Copyright>Copyright (c) 2013-2026 Elekto Produtos Financeiros</Copyright>

    <!-- Enable Source Link for debugging -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\assets\elekto_logo_sq.300x300.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- Polyfill for netstandard2.0 -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Text.Json" Version="10.0.13" />
    <PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="6.1.2" />
  </ItemGroup>

</Project>
