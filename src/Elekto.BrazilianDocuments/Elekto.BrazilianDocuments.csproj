<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0;net11.0;netstandard2.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <CLSCompliant>true</CLSCompliant>

    <!-- NuGet Package Configuration -->
    <PackageId>Elekto.BrazilianDocuments</PackageId>
    <Title>Brazilian Documents (CPF/CNPJ)</Title>
    <Version>1.4.1</Version>
    <Authors>Elekto Produtos Financeiros</Authors>
    <Company>Elekto</Company>
    <Description>High-performance, zero-allocation validation for Brazilian documents (CNPJ and CPF). Supports the new alphanumeric CNPJ format introduced by Brazilian Federal Revenue Service.</Description>
    <PackageReleaseNotes>v1.4.1: Validating a CNPJ is about twice as fast for numeric CNPJs and 40% faster for alphanumeric ones, as measured on .NET 10 and 11. A CNPJ that holds a letter or digit outside ASCII is now invalid: an accented letter, the Turkish İ or ı, a fullwidth digit, and also a superscript digit or a combining accent. IsValid used to skip them like punctuation, while the constructor kept the letters and digits in the value, and turned the long s (ſ) into an S, which made the value an invalid CNPJ. Cnpj.Create, which already rejected accented letters, now also rejects the long s, combining accents and superscript digits. A Cnpj read from XML is now stored as the constructor stores it: written in lowercase, or with punctuation in place of a leading zero, it did not equal the same CNPJ parsed from a string. Punctuation and spaces, ASCII or not, are still ignored, and Cpf is unchanged.</PackageReleaseNotes>
    <PackageTags>cnpj;cpf;brazil;brazilian;validation;documents;receita-federal</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/elekto-com-br/cnpj-cpf</PackageProjectUrl>
    <RepositoryUrl>https://github.com/elekto-com-br/cnpj-cpf</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>elekto_logo_sq.300x300.png</PackageIcon>
    <Copyright>Copyright (c) 2013-2026 Elekto Produtos Financeiros</Copyright>

    <!-- Enable Source Link for debugging -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\assets\elekto_logo_sq.300x300.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- Polyfill for netstandard2.0 -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Text.Json" Version="10.0.14" />
    <PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="6.1.2" />
  </ItemGroup>

</Project>
